{
  "node": {
    "id": "alg.point3d.octree_box_search",
    "name": "盒检索",
    "group": "3D 点云",
    "category": "处理",
    "description": "Octree 盒检索（轴对齐盒 box_min~box_max）：返回盒内全部点（闭区间，含边界点），按到盒中心的欧氏距离升序；盒内无点属正常成功（hits=0，不报错）；无输出端口，消息恒以 octree_box hits/box 开头并列出前 30 组 idx:dist；定位：区域取点 / 盒域 AOI 裁选（半径球域之外的轴对齐盒查询，KdTree 无对应接口）"
  },
  "runtime": "native",
  "assembly": "Point3DAlg.dll",
  "method": "Point3DAlg_ComuiOctreeBoxSearch",
  "inputs": [
    {
      "name": "点云",
      "type": "cloud"
    }
  ],
  "params": [
    {
      "name": "min_x",
      "label": "盒下限X",
      "type": "number",
      "default": 0.0,
      "description": "盒最小 X（每维须 min < max，含等值/NaN 报参数非法）"
    },
    {
      "name": "min_y",
      "label": "盒下限Y",
      "type": "number",
      "default": 0.0,
      "description": "盒最小 Y"
    },
    {
      "name": "min_z",
      "label": "盒下限Z",
      "type": "number",
      "default": 0.0,
      "description": "盒最小 Z"
    },
    {
      "name": "max_x",
      "label": "盒上限X",
      "type": "number",
      "default": 10.0,
      "description": "盒最大 X"
    },
    {
      "name": "max_y",
      "label": "盒上限Y",
      "type": "number",
      "default": 10.0,
      "description": "盒最大 Y"
    },
    {
      "name": "max_z",
      "label": "盒上限Z",
      "type": "number",
      "default": 10.0,
      "description": "盒最大 Z"
    }
  ],
  "outputs": [],
  "source": {
    "files": [
      "integration/comui/Point3DAlg_comui.cpp",
      "integration/comui/comui_native_abi.h",
