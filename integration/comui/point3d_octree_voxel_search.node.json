{
  "node": {
    "id": "alg.point3d.octree_voxel_search",
    "name": "体素检索",
    "group": "3D 点云",
    "category": "处理",
    "description": "Octree 体素检索（query 查询点 + resolution 体素边长）：返回查询点所在体素内全部点，按到查询点的欧氏距离升序（体素归属按 floor 划分）；查询体素无点属正常成功（hits=0，不报错）；无输出端口，消息恒以 octree_voxel res/hits 开头并列出前 30 组 idx:dist；定位：同体素点集提取 / 局部密度诊断 / voxel leaf 选参辅助"
  },
  "runtime": "native",
  "assembly": "Point3DAlg.dll",
  "method": "Point3DAlg_ComuiOctreeVoxelSearch",
  "inputs": [
    {
      "name": "点云",
      "type": "cloud"
    }
  ],
  "params": [
    {
      "name": "query_x",
      "label": "查询点X",
      "type": "number",
      "default": 0.0,
      "description": "查询点 X 坐标（与点云同单位）"
    },
    {
      "name": "query_y",
      "label": "查询点Y",
      "type": "number",
      "default": 0.0,
      "description": "查询点 Y 坐标"
    },
    {
      "name": "query_z",
      "label": "查询点Z",
      "type": "number",
      "default": 0.0,
      "description": "查询点 Z 坐标"
    },
    {
      "name": "resolution",
      "label": "体素边长",
      "type": "number",
      "default": 1.0,
      "min": 0.000001,
      "description": "体素边长（>0，与点云坐标同单位；<=0 报参数非法）"
    }
  ],
  "outputs": [],
  "source": {
    "files": [
      "integration/comui/Point3DAlg_comui.cpp",
      "integration/comui/comui_native_abi.h",
      "src/AlgExport.h",
      "src/Point3DAlg/include/Point3DAlg_api.h",
      "src/Point3DAlg/Point3DAlg_CloudOps.cpp",
      "src/ShapelyAlg/CloudProcessor.h",
      "src/ShapelyAlg/CloudProcessor.cpp"
    ],
    "includes": [
      "src",
      "src/ShapelyAlg"
    ]
  }
}
