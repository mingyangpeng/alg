  "assembly": "Image2DAlg.dll",
  "method": "Image2DAlg_ComuiFourierSpectrum",
  "inputs": [
    {
      "name": "输入",
      "type": "image"
    }
  ],
  "params": [],
  "outputs": [
    {
      "name": "谱图",
